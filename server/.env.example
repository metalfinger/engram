# Engram server configuration — copy to .env (gitignored) and fill in.
# Run with PYTHONUTF8=1 (start-engram.ps1 sets it).

# Brain checkout
ENGRAM_BRAIN_PATH=C:\Users\Admin\.engram\brain
ENGRAM_BRAIN_REMOTE=git@github.com:metalfinger/brain.git
ENGRAM_DEPLOY_KEY_PATH=C:\Users\Admin\.engram\id_engram

# HTTP
ENGRAM_MCP_PORT=9210
ENGRAM_PUBLIC_URL=https://engram.metalfinger.xyz
ENGRAM_EXPLORER_URL=https://brain.metalfinger.xyz

# OAuth — GitHub OAuth App (Runbook A): callback = <PUBLIC_URL>/oauth/callback
ENGRAM_OAUTH_PROVIDER=github
ENGRAM_GITHUB_CLIENT_ID=
ENGRAM_GITHUB_CLIENT_SECRET=
ENGRAM_OAUTH_STORE_PATH=C:\Users\Admin\.engram\oauth_store.json
ENGRAM_ALLOWED_LOGINS=metalfinger

# Cloudflare Access (Runbook B) — protects the explorer hostname
ENGRAM_CF_ACCESS_TEAM_DOMAIN=
ENGRAM_CF_ACCESS_AUD=
